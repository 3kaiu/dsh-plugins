{
  "name": "@3kaiu/dsh-llm-opencode-zen",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin: resilient OpenCode Zen free-tier LLM adapter with dynamic free-model catalog.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "typert.host.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test/rate-limit.test.mjs && node test/reasoning-echo.test.mjs && node test/catalog.test.mjs && node test/network-error.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@3kaiu/dsh-plugin-kit": "workspace:*",
    "@deepseek-ai/dsh-credentials": "next",
    "@deepseek-ai/dsh-launch-environment": "next",
    "@deepseek-ai/dsh-llm": "next",
    "@deepseek-ai/dsh-settings": "next",
    "@deepseek-ai/dsh-timeout": "next",
    "@deepseek-ai/dsh-typert-protocol": "next",
    "@deepseek-ai/schemastery": "3.18.1",
    "esbuild": "^0.24.2",
    "eventsource-parser": "3.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-launch-environment": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.7",
    "@deepseek-ai/schemastery": "*",
    "eventsource-parser": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-timeout": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "eventsource-parser": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.4.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode-zen",
    "llm",
    "plugin",
    "dsh-plugin"
  ],
  "license": "MIT"
}
