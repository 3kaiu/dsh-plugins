{
  "name": "@3kaiu/dsh-llm-opencode-zen",
  "version": "0.4.0",
  "description": "DeepSeek Harness plugin: resilient OpenCode Zen free-tier LLM adapter with dynamic free-model catalog.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "typert.host.js"
  ],
  "scripts": {
    "build": "tsx build.ts",
    "test": "tsx build.ts && tsx test/rate-limit.test.ts && tsx test/reasoning-echo.test.ts && tsx test/catalog.test.ts && tsx test/network-error.test.ts && tsx test/error-classify.test.ts && tsx test/options-map.test.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "@3kaiu/dsh-plugin-kit": "workspace:*",
    "esbuild": "^0.24.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode-zen",
    "llm",
    "plugin",
    "dsh-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-launch-environment": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "eventsource-parser": "3.1.1",
    "zod": "^4.4.0"
  }
}
