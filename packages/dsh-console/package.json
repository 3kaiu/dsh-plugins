{
  "name": "@3kaiu/dsh-console",
  "version": "0.1.0",
  "description": "DSH Console: dsh web 插件——事件库(REST+WS)+ 四页工作台前端,随官方运行时启动(默认 3090);也可独立运行",
  "type": "module",
  "bin": {
    "dsh-console": "dist/server.mjs"
  },
  "main": "dist/plugin.mjs",
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs && vite build",
    "dev": "vite",
    "start": "node dist/server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.3",
    "@preact/signals": "^1.3.1",
    "preact": "^10.25.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "keywords": [
    "dsh",
    "console",
    "dashboard",
    "events",
    "agent-workbench"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./dist/plugin.mjs"
  }
}
