{
  "name": "@3kaiu/dsh-github-sync",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: GitHub sync (read side) — pulls CI workflow runs and PR states into the local event library, filling the test/completion families (source=github) with idempotent incremental polling.",
  "type": "module",
  "main": "dist/index.js",
  "exports": { ".": "./dist/index.js" },
  "files": [ "dist", "cordis.patch.yml" ],
