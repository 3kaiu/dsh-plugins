    "build": "node build.mjs",
    "test": "node build.mjs && node test/github-sync.test.mjs"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "keywords": [ "dsh", "deepseek-harness", "github", "ci", "sync", "events", "dsh-plugin" ],
