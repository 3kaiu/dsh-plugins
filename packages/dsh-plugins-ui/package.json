{
  "name": "@3kaiu/dsh-plugins-ui",
  "version": "0.1.0",
  "description": "DSH 插件设置 UI:设置弹窗「插件」tab 的浏览器侧卡片(schema 驱动,覆盖全部 @3kaiu 插件配置)。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./typert": "./typert.host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "typert.host.js"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.7",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "settings",
    "ui",
    "dsh-plugin"
  ],
  "license": "MIT"
}
