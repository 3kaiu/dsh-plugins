{
  "name": "@3kaiu/dsh-harness-updater",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: daily registry version check for @deepseek-ai/dsh, macOS native notification on new release. No runtime deps.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "updater",
    "plugin",
    "dsh-plugin"
  ],
  "license": "MIT"
}
